<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique reverse-DNS label. Used to address this agent in launchctl. -->
    <key>Label</key>
    <string>com.frame.dashboard</string>

    <!-- Run the FastAPI server using the project's venv uvicorn directly.
         No --reload here — that's a development convenience and would have
         the agent restarting itself on every file save. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/path/to/docent/venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
        <string>--log-level</string>
        <string>info</string>
    </array>

    <!-- Run uvicorn with the project root as cwd so app.main resolves and
         the SQLite file lands in data/ as before. -->
    <key>WorkingDirectory</key>
    <string>/Users/YOU/path/to/docent</string>

    <!-- Start at login, and keep alive — if the server ever crashes (TV
         dropped a malformed payload, OOM, whatever), launchd restarts it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restarts so a flapping server doesn't pin the CPU. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logs go to disk so we can inspect what happened after the fact. -->
    <key>StandardOutPath</key>
    <string>/Users/YOU/path/to/docent/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/path/to/docent/data/launchd.err.log</string>

    <!-- Inherit the user's PATH so subprocess calls (Python finding system
         tools, Pillow's image format detection, etc.) behave like manual runs. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
